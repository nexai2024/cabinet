# Optional: lets the model read files whose structure the readers cannot infer.
# Create an API key at https://freebuff.com/account/api and put it in .env
OPENAI_API_KEY=

# Optional: one of gpt-4o-mini, gpt-4.1-mini, gpt-5-mini
AI_MODEL=gpt-4o-mini

# Required for every write: uploads, record saves, deletes and re-reads.
# Mutating requests send this value as `Authorization: Bearer <key>` or in an
# `x-cabinet-key` header. With no key set, every mutation answers 503.
# Generate one with: node -e "console.log(crypto.randomUUID())"
CABINET_TOKEN=

# Optional: require the access key for reads too (health and share links stay open).
CABINET_PROTECT_READS=false

# Optional: set to false to send file text to the model without PII redaction.
AI_REDACT_PII=true
